# Local development only. No cloud credentials or GPU are needed.
ENVIRONMENT=development
AI_PROVIDER=mock
# Free GPU profile (explicit setup only; consumes the front/first photo):
# AI_PROVIDER=local_triposr
# LOCAL_TRIPOSR_PYTHON=D:\models\triposr-venv\Scripts\python.exe
# LOCAL_TRIPOSR_SOURCE=D:\models\triposr-src
# LOCAL_TRIPOSR_MODEL_PATH=D:\models\triposr-weights
LOCAL_TRIPOSR_TIMEOUT_SECONDS=900
LOCAL_TRIPOSR_MC_RESOLUTION=256
AI_QUEUE_MAX_JOBS=20
# Paid generation requires explicit AI_PROVIDER=meshy or tripo, its key, RQ, and a positive cap.
# Keep 0 until an authorized merchant chooses to spend credits. Never paste keys into Git.
MESHY_API_KEY=
MESHY_DAILY_REQUEST_LIMIT=0
GENERATION_SELLER_DAILY_LIMIT=20
MESHY_POLL_SECONDS=10
MESHY_TIMEOUT_SECONDS=900
TRIPO_API_KEY=
TRIPO_DAILY_REQUEST_LIMIT=0
TRIPO_POLL_SECONDS=10
TRIPO_TIMEOUT_SECONDS=900
GENERATION_STALE_SECONDS=600
DEV_AUTH_ENABLED=true
POSTGRES_DB=ayna
POSTGRES_USER=ayna
POSTGRES_PASSWORD=ayna-local-only-change-me
S3_ACCESS_KEY=ayna-local
S3_SECRET_KEY=ayna-local-only-change-me
S3_BUCKET=ayna-private
ASSET_SIGNING_KEY=ayna-local-signing-key-change-before-production
CORS_ORIGINS=["http://localhost:5173"]
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
QUALITY_DEVICE=cpu
QUALITY_MAX_IMAGE_SIZE=384
QUALITY_ENABLE_SAM2=false
QUALITY_ENABLE_DINOV2=false
QUALITY_ENABLE_OPENCV_ALIGNMENT=false
# QUALITY_SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_t.yaml
# QUALITY_SAM2_CHECKPOINT=C:\path\outside\the\repository\sam2.1_hiera_tiny.pt
# QUALITY_DINOV2_MODEL_PATH=C:\path\outside\the\repository\dinov2-small
BLENDER_OPTIMIZATION_ENABLED=false
# BLENDER_EXECUTABLE=C:\Program Files\Blender Foundation\Blender 4.3\blender.exe
BLENDER_TIMEOUT_SECONDS=180
BLENDER_TARGET_TRIANGLES=20000
# Diagnostic is private framing/job-lifecycle only. Optional fashn_vton is clothing-only and
# demo/evaluation-only because fashn-human-parser inherits NVIDIA noncommercial terms.
TRYON_PROVIDER=diagnostic
TRYON_RETENTION_HOURS=24
TRYON_MAX_IMAGE_BYTES=10485760
# TRYON_PYTHON=D:\models\fashn-vton-venv\Scripts\python.exe
# TRYON_SOURCE_PATH=D:\models\fashn-vton-src
# TRYON_WEIGHTS_PATH=D:\models\fashn-vton-weights
TRYON_TIMEOUT_SECONDS=900
TRYON_FASHN_NONCOMMERCIAL_DEPENDENCY_ACKNOWLEDGED=false
MAINTENANCE_INTERVAL_SECONDS=60
VITE_API_BASE_URL=http://localhost:8000
API_PORT=8000
WEB_PORT=5173
CURRENCY=BDT
STOREFRONT_URL=http://localhost:5173
DEMO_PAYMENTS_ENABLED=true
# Optional hosted payments. Both values are required to show the option.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Production password recovery uses a configured mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ayna <noreply@example.com>
SMTP_STARTTLS=true
# For a local R2 adapter set S3_ENDPOINT_URL, S3_REGION and private bucket credentials.
# Use HTTPS, disable development auth/demo payments and configure secrets before production.
